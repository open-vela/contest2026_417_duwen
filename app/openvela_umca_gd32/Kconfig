config LVX_USE_DEMO_CONTEST2026_417_UMCA_GD32
	bool "UMCA GD32 UART node"
	default n
	depends on UMCA_PROFILE_DISCOVERY
	select UMCA_BUILD_UART
	---help---
		Build a single-context UMCA discovery node for GD32 hardware. The UART
		device and node identifiers are supplied at runtime; no USART pin or
		application role is hard-coded.

