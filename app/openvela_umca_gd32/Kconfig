	string "Program name"
	default "umca_gd32"

config LVX_USE_DEMO_CONTEST2026_417_UMCA_GD32_PRIORITY
	int "Task priority"
	default 100

config LVX_USE_DEMO_CONTEST2026_417_UMCA_GD32_STACKSIZE
	int "Task stack size"
	default 6144

endif
