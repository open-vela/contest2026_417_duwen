config UMCA
	bool "Unified Modular Communication Architecture"
	default n
	---help---
		Enable the platform-independent UMCA core.

if UMCA

choice UMCA_PROFILE
	prompt "UMCA profile"
	default UMCA_PROFILE_DISCOVERY

config UMCA_PROFILE_MINIMAL
	bool "Minimal"

config UMCA_PROFILE_DISCOVERY
	bool "Discovery"

config UMCA_PROFILE_CONTEST
	bool "Contest"

endchoice

config UMCA_BUILD_LOOPBACK
	bool "Loopback PHY"
	default y

config UMCA_BUILD_UART
	bool "UART PHY"
	default n
	---help---
		Build the static UART byte-stream PHY adapter. The application supplies
		the platform UART read/write callbacks.

config LVX_USE_DEMO_CONTEST2026_417_UMCA_AGENT
	bool "UMCA openvela demo agent"
	depends on !UMCA_PROFILE_MINIMAL
	default n
	---help---
		Enable the Goldfish three-node UMCA service application.

endif
